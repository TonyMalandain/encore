[Unit]
Description=Encore Standalone Wayland Kiosk
After=network-online.target systemd-user-sessions.service
Wants=network-online.target

[Service]
User=encore
Group=encore
PAMName=login
WorkingDirectory=/var/lib/encore
Environment=HOME=/var/lib/encore
# The client's own account of a failed connection has never reached the
# journal. This covers the phase before the profile — which already asks for
# freerdp_log_level=INFO — is read. G_MESSAGES_DEBUG is deliberately NOT set:
# it floods the journal with GTK chatter, and the logging that matters here
# does not go through GLib.
Environment=WLOG_LEVEL=INFO
# Read this capability's log with `journalctl -t encore-kiosk`, never with
# `journalctl -u`. PAMName=login below makes logind move our processes into a
# login session scope under the user slice, so their cgroup at the moment of
# logging is session-N.scope and not this unit — which is what `-u` matches on.
# The identifier is stamped on the journal stream systemd opens for the unit's
# output, and processes keep that stream across the cgroup move. It also names
# the capability rather than the compositor, so replacing cage does not change
# the query an operator has to know.
SyslogIdentifier=encore-kiosk
#purposefully disable gnome-keyring for password storage
InaccessiblePaths=-/usr/lib/x86_64-linux-gnu/remmina/plugins/remmina-plugin-secret.so
InaccessiblePaths=-/usr/lib/aarch64-linux-gnu/remmina/plugins/remmina-plugin-secret.so
InaccessiblePaths=-/usr/lib/arm-linux-gnueabihf/remmina/plugins/remmina-plugin-secret.so
ExecStartPre=+/usr/bin/chvt 7
ExecStart=/usr/bin/cage -s -- /usr/local/bin/encore-kiosk.sh
ExecStopPost=+/usr/bin/chvt 1
Restart=always
RestartSec=3
TimeoutStopSec=10s
KillMode=mixed

#Required permissions for libseat to acquire the console
StandardInput=tty
StandardOutput=journal
TTYPath=/dev/tty7
UtmpIdentifier=tty7
TTYReset=yes
TTYVHangup=yes


# Sandboxing
ProtectSystem=yes
#ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=encore-kiosk.target
